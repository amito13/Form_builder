{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "declaration": true,

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": [
    "user/**/*.ts",
    "form/**/*.ts",
    "form-field/**/*.ts",
    "form-submission/**/*.ts"
  ],

  "exclude": [
    "dist",
    "node_modules"
  ]
}